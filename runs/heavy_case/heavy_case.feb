					<dtol>0.001</dtol>
					<etol>0.01</etol>
					<rtol>0.0</rtol>
					<rhoi>-2.0</rhoi>
					<alpha>1.0</alpha>
					<beta>0.25</beta>
					<gamma>0.25</gamma>
					<logSolve>0.0</logSolve>
					<arc_length>0.0</arc_length>
					<arc_length_scale>0.0</arc_length_scale>
					<qn_method type="BFGS">
						<max_ups>10.0</max_ups>
						<max_buffer_size>0.0</max_buffer_size>
						<cycle_buffer>1.0</cycle_buffer>
						<cmax>100000.0</cmax>
					</qn_method>
				</solver>
			</Control>
			<Boundary>
				<bc name="chest" type="zero displacement" node_set="@surface:chest_part">
					<x_dof>1</x_dof>
					<y_dof>1</y_dof>
					<z_dof>1</z_dof>
				</bc>
			</Boundary>
		</step>
		<step id="2" name="Step2">
			<Control>
				<analysis>DYNAMIC</analysis>
				<time_steps>120.0</time_steps>
				<step_size>0.01</step_size>
				<plot_zero_state>0</plot_zero_state>
				<plot_range>0,-1</plot_range>
				<plot_level>PLOT_MUST_POINTS</plot_level>
				<output_level>OUTPUT_MUST_POINTS</output_level>
				<plot_stride>1</plot_stride>
				<output_stride>1</output_stride>
				<adaptor_re_solve>1</adaptor_re_solve>
				<time_stepper type="default">
					<max_retries>20.0</max_retries>
					<opt_iter>11.0</opt_iter>
					<dtmin>0.0</dtmin>
					<dtmax lc="3">0.01</dtmax>
					<aggressiveness>0.0</aggressiveness>
					<cutback>0.5</cutback>
					<dtforce>0.0</dtforce>
				</time_stepper>
				<solver type="solid">
					<symmetric_stiffness>symmetric</symmetric_stiffness>
					<equation_scheme>staggered</equation_scheme>
					<equation_order>default</equation_order>
					<optimize_bw>0.0</optimize_bw>
					<lstol>0.9</lstol>
					<lsmin>0.01</lsmin>
					<lsiter>5.0</lsiter>
					<ls_check_jacobians>0.0</ls_check_jacobians>
					<max_refs>15.0</max_refs>
					<check_zero_diagonal>0.0</check_zero_diagonal>
					<zero_diagonal_tol>0.0</zero_diagonal_tol>
					<force_partition>0.0</force_partition>
					<reform_each_time_step>1.0</reform_each_time_step>
					<reform_augment>0.0</reform_augment>
					<diverge_reform>1.0</diverge_reform>
					<min_residual>1e-20</min_residual>
					<max_residual>0.0</max_residual>
					<dtol>0.001</dtol>
					<etol>0.01</etol>
					<rtol>0.0</rtol>
					<rhoi>-2.0</rhoi>
					<alpha>1.0</alpha>
					<beta>1.0</beta>
					<gamma>1.5</gamma>
					<logSolve>0.0</logSolve>
					<arc_length>0.0</arc_length>
					<arc_length_scale>0.0</arc_length_scale>
					<qn_method type="BFGS">
						<max_ups>10.0</max_ups>
						<max_buffer_size>0.0</max_buffer_size>
						<cycle_buffer>1.0</cycle_buffer>
						<cmax>100000.0</cmax>
					</qn_method>
				</solver>
			</Control>
			<Boundary>
				<bc name="parabolic_trajectory" type="prescribed displacement" node_set="@surface:chest_part">
					<dof>z</dof>
					<value lc="2">1</value>
					<relative>0</relative>
				</bc>
				<bc name="only_z_displacement" type="zero displacement" node_set="@surface:chest_part">
					<x_dof>1</x_dof>
					<y_dof>1</y_dof>
					<z_dof>0</z_dof>
				</bc>
			</Boundary>
			<Loads>
				<body_load type="mass damping" elem_set="@part_list:Mass_damping">
					<C>20</C>
				</body_load>
			</Loads>
		</step>
	</Step>

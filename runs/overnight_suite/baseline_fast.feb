					<reform_augment>0.0</reform_augment>
					<diverge_reform>1.0</diverge_reform>
					<min_residual>1e-20</min_residual>
					<max_residual>0.0</max_residual>
					<dtol>0.001</dtol>
					<etol>0.01</etol>
					<rtol>0.0</rtol>
					<rhoi>-2.0</rhoi>
					<alpha>1.0</alpha>
					<beta>1.0</beta>
					<gamma>1.5</gamma>
					<logSolve>0.0</logSolve>
					<arc_length>0.0</arc_length>
					<arc_length_scale>0.0</arc_length_scale>
					<qn_method type="BFGS">
						<max_ups>10.0</max_ups>
						<max_buffer_size>0.0</max_buffer_size>
						<cycle_buffer>1.0</cycle_buffer>
						<cmax>100000.0</cmax>
					</qn_method>
				</solver>
			</Control>
			<Boundary>
				<bc name="parabolic_trajectory" type="prescribed displacement" node_set="@surface:chest_part">
					<dof>z</dof>
					<value lc="2">1</value>
					<relative>0</relative>
				</bc>
				<bc name="only_z_displacement" type="zero displacement" node_set="@surface:chest_part">
					<x_dof>1</x_dof>
					<y_dof>1</y_dof>
					<z_dof>0</z_dof>
				</bc>
			</Boundary>
			<Loads>
				<body_load type="mass damping" elem_set="@part_list:Mass_damping">
					<C>20</C>
				</body_load>
			</Loads>
		</step>
	</Step>

					<max_retries>40.0</max_retries>
					<opt_iter>11.0</opt_iter>
					<dtmin>0.0</dtmin>
					<dtmax>0.1</dtmax>
					<aggressiveness>0.0</aggressiveness>
					<cutback>0.5</cutback>
					<dtforce>0.0</dtforce>
				</time_stepper>
				<solver type="solid">
					<symmetric_stiffness>symmetric</symmetric_stiffness>
					<equation_scheme>staggered</equation_scheme>

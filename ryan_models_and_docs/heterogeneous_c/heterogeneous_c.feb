					<max_residual>0.0</max_residual>
					<dtol>0.001</dtol>
					<etol>0.01</etol>
					<rtol>0.0</rtol>
					<rhoi>-2.0</rhoi>
					<alpha>1.0</alpha>
					<beta>0.25</beta>
					<gamma>0.25</gamma>
					<logSolve>0.0</logSolve>
